<Window x:Class="MinerU25Tool.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_HelpTitle}" Height="520" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Theme.CardBg}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Theme.Fg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
        <StackPanel>
            <TextBlock Text="{DynamicResource S_HelpKeys}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Theme.Fg}" Margin="0,0,0,6"/>
            <TextBlock Foreground="{DynamicResource Theme.FgDim}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="{DynamicResource S_HelpKeysBody}"/>
            <TextBlock Text="{DynamicResource S_HelpCli}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Theme.Fg}" Margin="0,0,0,6"/>
            <TextBox IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                     Background="{DynamicResource Theme.AppBg}" Foreground="{DynamicResource Theme.FgDim}" BorderThickness="0" Padding="8"
                     Text="{DynamicResource S_HelpCliBody}"/>
            <TextBlock Text="{DynamicResource S_HelpEngines}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Theme.Fg}" Margin="0,12,0,6"/>
            <TextBlock Foreground="{DynamicResource Theme.FgDim}" TextWrapping="Wrap"
                       Text="{DynamicResource S_HelpEnginesBody}"/>
            <TextBlock Text="{DynamicResource S_HelpNotes}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Theme.Fg}" Margin="0,12,0,6"/>
            <TextBlock Foreground="{DynamicResource Theme.FgDim}" TextWrapping="Wrap"
                       Text="{DynamicResource S_HelpNotesBody}"/>
            <Button Content="{DynamicResource S_HelpClose}" Width="120" Height="32" Margin="0,16,0,0" HorizontalAlignment="Right"
                    Background="{DynamicResource Theme.BtnBg}" Foreground="{DynamicResource Theme.Fg}" BorderThickness="0" Cursor="Hand" Click="CloseBtn_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
